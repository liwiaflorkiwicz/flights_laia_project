FROM ghcr.io/mlflow/mlflow:latest
RUN pip install --no-cache-dir psycopg2-binary boto3
EXPOSE 5050
CMD ["mlflow", "server", "--host", "0.0.0.0", "--port",
 "5050", "--backend-store-uri", "sqlite:///mlflow/mlflow.db",
 "--artifacts-destination", "/mlflow/mlruns", "--serve-artifacts", "--allowed-hosts", "*"]